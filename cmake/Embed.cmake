# rega_embed(<out.cpp> <NAME> <file> [<NAME> <file>]...)
#
# Writes <out.cpp> defining, in namespace rega::assets, for each pair:
#   extern const std::uint8_t NAME[];  extern const std::size_t NAME_SIZE;
# holding <file>'s bytes. Regenerated when a file changes (at configure).
function(rega_embed out)
    set(body "")
    set(args ${ARGN})
    list(LENGTH args n)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last} 2)
        math(EXPR j "${i} + 1")
        list(GET args ${i} name)
        list(GET args ${j} file)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" hex HEX)
        file(SIZE "${file}" size)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        # A line break every 32 bytes keeps compilers' diagnostics sane.
        string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
        string(APPEND body
            "extern const std::uint8_t ${name}[];\n"
            "extern const std::size_t ${name}_SIZE;\n"
            "const std::uint8_t ${name}[] = {\n${bytes}\n};\n"
            "const std::size_t ${name}_SIZE = ${size};\n\n")
    endforeach()
    set(content "// Generated by cmake/Embed.cmake: do not edit.\n#include <cstddef>\n#include <cstdint>\n\nnamespace rega::assets\n{\n\n${body}} // namespace rega::assets\n")
    # Rewrite only on change, so the build doesn't recompile it every configure.
    if(EXISTS "${out}")
        file(READ "${out}" old)
        if(old STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${out}" "${content}")
endfunction()
