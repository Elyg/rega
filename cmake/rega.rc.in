// rega.exe's resources (Windows): its icon and version (configured by CMakeLists.txt).
#include <winver.h>

1 ICON "@CMAKE_SOURCE_DIR@/assets/icons/rega.ico"

VS_VERSION_INFO VERSIONINFO
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "rega: image and sequence viewer\0"
            VALUE "ProductName", "rega\0"
            VALUE "ProductVersion", "@PROJECT_VERSION_STRING@\0"
            VALUE "FileVersion", "@PROJECT_VERSION_STRING@\0"
            VALUE "OriginalFilename", "rega.exe\0"
            VALUE "LegalCopyright", "MIT licence\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
